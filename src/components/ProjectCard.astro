---
interface Testimonial {
  quote: string;
  name: string;
  role: string;
}

interface Props {
  title: string;
  category: string;
  summary: string;
  tags: string[];
  status?: string;
  testimonial?: Testimonial;
}

const { title, category, summary, tags, status, testimonial } = Astro.props;
---

<div class="card card-hover p-6 flex flex-col gap-4 h-full">
  <div class="aspect-video rounded-xl bg-[var(--color-surface)] border border-[var(--color-border)] flex items-center justify-center overflow-hidden relative">
    <div class="absolute inset-0 bg-gradient-to-br from-[var(--color-accent-soft)] via-transparent to-transparent"></div>
    <span class="text-xs text-[var(--color-ink-faint)] font-mono relative">Project preview</span>
    {status && (
      <span class="absolute top-3 right-3 flex items-center gap-1.5 bg-white/90 backdrop-blur border border-[var(--color-border)] rounded-full px-2.5 py-1 text-xs font-semibold text-[var(--color-ink)]">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)]"></span>
        {status}
      </span>
    )}
  </div>

  <div>
    <p class="eyebrow mb-1">{category}</p>
    <h3 class="text-lg font-bold tracking-tight">{title}</h3>
    <p class="text-sm text-[var(--color-ink-muted)] mt-2 leading-relaxed">{summary}</p>
  </div>

  <div class="flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="pill text-xs font-mono">
        {tag}
      </span>
    ))}
  </div>

  {testimonial && (
    <blockquote class="mt-auto pt-4 border-t border-[var(--color-border)]">
      <p class="text-sm text-[var(--color-ink-muted)] italic leading-relaxed">“{testimonial.quote}”</p>
      <footer class="text-xs font-semibold text-[var(--color-ink)] mt-3 not-italic">
        {testimonial.name} <span class="font-normal text-[var(--color-ink-faint)]">— {testimonial.role}</span>
      </footer>
    </blockquote>
  )}
</div>
