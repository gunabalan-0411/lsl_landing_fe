---
import { site } from "../data/site";

const links = [
  { href: "/services", label: "Services" },
  { href: "/work", label: "Work" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const current = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/85 backdrop-blur border-b border-[var(--color-border)]">
  <nav class="container-page flex items-center justify-between h-18 py-3">
    <a href="/" class="font-extrabold tracking-tight text-lg flex items-center gap-2">
      <span class="w-7 h-7 rounded-lg bg-[var(--color-accent)] flex items-center justify-center">
        <span class="w-2.5 h-2.5 rounded-full border-2 border-white"></span>
      </span>
      {site.name}
    </a>

    <ul class="hidden md:flex items-center gap-1 text-sm font-medium">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              "px-4 py-2 rounded-full transition-colors",
              current === link.href
                ? "bg-[var(--color-surface)] text-[var(--color-ink)]"
                : "text-[var(--color-ink-muted)] hover:text-[var(--color-ink)] hover:bg-[var(--color-surface)]",
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <a href="/contact" class="btn btn-primary text-sm hidden sm:inline-flex">Start a project</a>

      <details class="md:hidden relative">
        <summary class="list-none cursor-pointer w-10 h-10 flex items-center justify-center rounded-full border border-[var(--color-border)]">
          <span class="sr-only">Menu</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </summary>
        <ul class="absolute right-0 top-12 w-52 card p-2 flex flex-col gap-1 text-sm z-50">
          {links.map((link) => (
            <li>
              <a href={link.href} class="block px-3 py-2 rounded-lg hover:bg-[var(--color-surface)]">
                {link.label}
              </a>
            </li>
          ))}
          <li>
            <a href="/contact" class="block px-3 py-2 rounded-lg text-[var(--color-accent)] font-medium">
              Start a project
            </a>
          </li>
        </ul>
      </details>
    </div>
  </nav>
</header>
