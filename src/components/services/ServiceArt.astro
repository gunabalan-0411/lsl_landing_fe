---
// One animated visual per practice (36 x 24 em artboard). Motion lives in src/scripts/services.ts.
interface Props {
  kind: string;
  paused?: boolean;
}
const { kind, paused = false } = Astro.props;

const uid = `${kind}-${paused ? "p" : "m"}`;
const icons: Record<string, string> = {
  db: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="6" rx="7" ry="2.6"/><path d="M5 6v12c0 1.4 3.1 2.6 7 2.6s7-1.2 7-2.6V6M5 12c0 1.4 3.1 2.6 7 2.6s7-1.2 7-2.6"/></svg>`,
  sheet: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2.5"/><path d="M4 10h16M4 15h16M10 4v16"/></svg>`,
  api: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 7l-5 5 5 5M16 7l5 5-5 5M13.5 5l-3 14"/></svg>`,
};
const tick = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>`;

// Data science: 14 months of actuals, then a 5-month forecast with a widening band (art em coordinates).
const X = (i: number) => 4.6 + i * 1.45;
const actual = (i: number) => 17.4 - 0.55 * i - 1.15 * Math.sin(i * 0.95);
const fc = (i: number) => 17.4 - 0.55 * i - 0.95 * Math.sin(i * 0.95);
const pts = Array.from({ length: 14 }, (_, i) => [X(i), actual(i)]);
const trend = `M${X(0)} ${17.5}L${X(13)} ${17.5 - 0.55 * 13}`;
const fIdx = [13, 14, 15, 16, 17, 18];
const fcLine = "M" + fIdx.map((i) => `${X(i).toFixed(2)} ${fc(i).toFixed(2)}`).join("L");
const band =
  "M" +
  fIdx.map((i) => `${X(i).toFixed(2)} ${(fc(i) - 0.3 - 0.32 * (i - 13)).toFixed(2)}`).join("L") +
  "L" +
  [...fIdx].reverse().map((i) => `${X(i).toFixed(2)} ${(fc(i) + 0.3 + 0.32 * (i - 13)).toFixed(2)}`).join("L") +
  "Z";
---

<div class="sc-art" data-scene={`sv-${kind}`} data-paused={paused ? "" : undefined} aria-hidden="true">
  {kind === "web" && (
    <>
      <div class="w-win">
        <div class="w-bar"><i /><i /><i /><span class="w-url"><span class="w-url-t">yourbrand.com</span></span></div>
        <i class="w-blk w-h" />
        <i class="w-blk w-s" />
        <i class="w-blk w-btn" />
        <i class="w-blk w-img" />
        <i class="w-blk w-card" />
        <i class="w-blk w-card" />
        <i class="w-blk w-card" />
      </div>
      <i class="w-ripple" />
      <div class="sv-chip" style="left:2.2em;top:6.4em"><span set:html={tick} />Responsive</div>
      <div class="sv-chip" style="left:3.6em;top:12.8em"><span set:html={tick} />Fast</div>
      <div class="sv-chip" style="left:25.4em;top:9.2em"><span set:html={tick} />SEO-ready</div>
      <div class="sv-chip" style="left:24.8em;top:15.6em"><span set:html={tick} />Accessible</div>
      <svg class="w-cursor" viewBox="0 0 24 24"><path d="M5 3l14 8.5-6.2 1.5L9.6 19z" fill="#fff" stroke="#0b1424" stroke-width="1.4" stroke-linejoin="round" /></svg>
    </>
  )}

  {kind === "ai" && (
    <>
      <div class="ai-user">Remind parents whose fees are due this week.</div>
      <div class="ai-agent"><i class="ai-dot" />Agent<span class="ai-think"><i /><i /><i /></span></div>
      <i class="ai-line" />
      {[
        ["find_due_fees(this_week)", "18 students"],
        ['draft_message(lang="ta, en")', "2 drafts"],
        ["send_reminders()", "18 sent"],
      ].map(([fn, res], i) => (
        <div class="ai-tool sc-panel" style={`top:${8.3 + i * 2.95}em`}>
          <span class="ai-st"><i class="ai-spin" /><span class="ai-ok" set:html={tick} /></span>
          <code>{fn}</code>
          <span class="ai-res">{res}</span>
        </div>
      ))}
      <div class="ai-ans"><span class="ai-ans-t">Done. 18 parents reminded, in Tamil and English.</span></div>
    </>
  )}

  {kind === "ds" && (
    <>
      <div class="d-card sc-panel">
        <div class="d-head"><b>Monthly demand</b><span class="d-leg"><i class="is-a" />Actual<i class="is-f" />Forecast</span></div>
      </div>
      <svg class="d-svg" viewBox="0 0 36 24">
        {[7, 10, 13, 16, 19].map((y) => <line class="d-grid" x1="4" x2="32" y1={y} y2={y} />)}
        <clipPath id={`dclip-${uid}`}><rect class="d-clip" x={X(13) - 0.6} y="0" width="10" height="24" /></clipPath>
        <g clip-path={`url(#dclip-${uid})`}>
          <path class="d-band" d={band} />
          <path class="d-fc" d={fcLine} />
        </g>
        <path class="d-trend" pathLength="1" d={trend} />
        {pts.map(([x, y]) => <circle class="d-pt" cx={x.toFixed(2)} cy={y.toFixed(2)} r="0.36" />)}
      </svg>
      <div class="d-kpi">Next quarter ↑</div>
      <div class="d-tags"><span>Seasonality</span><span>Trend</span><span>Holidays</span></div>
    </>
  )}

  {kind === "de" && (
    <>
      <svg class="e-svg" viewBox="0 0 36 24">
        <path class="e-edge" d="M10.8 4.7C12.4 4.7 12.2 12 13.6 12" />
        <path class="e-edge" d="M10.8 12C12.2 12 12.2 12 13.6 12" />
        <path class="e-edge" d="M10.8 19.3C12.4 19.3 12.2 12 13.6 12" />
        <path class="e-edge" d="M22.4 12C23.6 12 24.4 12 25.6 12" />
      </svg>
      {[
        ["Orders DB", "postgres", 2.6, "db"],
        ["Sheets", "excel", 9.9, "sheet"],
        ["Partner API", "rest", 17.2, "api"],
      ].map(([name, sub, top, ico]) => (
        <div class="e-node e-src sc-panel" style={`top:${top}em`}>
          <span class="e-ico" set:html={icons[ico as string]} />
          <div><b>{name}</b><small class="mono">{sub}</small></div>
        </div>
      ))}
      <div class="e-node e-x sc-panel">
        <svg class="e-gear" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3.2" /><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M5.3 18.7l2.1-2.1M16.6 7.4l2.1-2.1" stroke-linecap="round" /></svg>
        <b>Transform</b>
        {["Clean", "Join", "Validate"].map((s) => <span class="e-chk"><i set:html={tick} />{s}</span>)}
      </div>
      <div class="e-node e-wh sc-panel">
        <svg class="e-cyl" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><ellipse cx="12" cy="5.5" rx="7.5" ry="2.8" /><path d="M4.5 5.5v13c0 1.5 3.4 2.8 7.5 2.8s7.5-1.3 7.5-2.8v-13M4.5 12c0 1.5 3.4 2.8 7.5 2.8s7.5-1.3 7.5-2.8" /></svg>
        <b>Warehouse</b>
        <small>rows synced</small>
        <span class="e-count mono">0</span>
      </div>
      {Array.from({ length: 5 }).map(() => <i class="e-dot" />)}
    </>
  )}

  {kind === "auto" && (
    <>
      <i class="u-line" />
      <i class="u-line u-line-on" />
      <div class="u-node u-trig sc-panel">
        <span class="u-clock"><i class="u-hand" /></span>
        <div><b>Every day · 7:00 AM</b><small>Trigger</small></div>
      </div>
      {[
        ["Pull yesterday's collections", "Database"],
        ["Build the summary", "AI"],
        ["Send it to the owner", "Email & SMS"],
      ].map(([title, via], i) => (
        <div class="u-node u-step sc-panel" style={`top:${7.4 + i * 4.6}em`}>
          <span class="u-ck" set:html={tick} />
          <div><b>{title}</b><small>{via}</small></div>
        </div>
      ))}
      <i class="u-token" />
      <div class="u-toast sc-panel">
        <span class="u-app">AL</span>
        <div><b>Daily report <small>now</small></b><span>₹42,300 collected · 3 unpaid</span></div>
      </div>
    </>
  )}
</div>
