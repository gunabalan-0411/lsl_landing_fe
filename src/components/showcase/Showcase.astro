---
import "../../styles/showcase.css";
import PacoCards from "./PacoCards.astro";
import TickBookCards from "./TickBookCards.astro";
import { projects } from "../../data/site";

const paco = projects.find((p) => p.slug === "paco-ai")!;
const tickbook = projects.find((p) => p.slug === "tickbook")!;

// Tamil glyphs the cards use, so Google Fonts serves a tiny subset of the two Tamil faces.
const tamil =
  "தமிழ் இன்னைக்கு என் கிளாஸ்ல யார் வரல? பேர் இன்று வரவில்லை ஆரவ் குமார் ரவி சங்கர் 14-10 புதன் முத்து செல்வராஜ் லட்சுமி அக்கா கல்யாணி மொத்தம் முருகன் கண்ணன் செல்வி 0123456789 G E-L";
const glyphs = encodeURIComponent([...new Set(tamil)].join(""));
const tamilFonts = `https://fonts.googleapis.com/css2?family=Anek+Tamil:wght@500;600&family=Kavivanar&display=swap&text=${glyphs}`;
---

<link rel="stylesheet" href={tamilFonts} />

<section id="work" style="background:var(--cx-surface);padding:110px 24px;border-top:1px solid var(--cx-border);transition:background .5s ease">
  <div style="max-width:76rem;margin-inline:auto">
    <div data-reveal style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:52px">
      <div>
        <span style="font-family:'JetBrains Mono',ui-monospace,monospace;font-size:12px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--cx-accent-ink)">Selected work</span>
        <h2 data-split style="margin:12px 0 0;font-size:clamp(30px,4vw,52px);line-height:1.04;letter-spacing:-.035em;font-weight:600;text-wrap:balance">Two products, built end to end</h2>
      </div>
      <p style="margin:0;max-width:27rem;font-size:15.5px;line-height:1.6;color:var(--cx-muted)">Every card is a live preview of what the product does. Press play on the wide card for the full film.</p>
    </div>

    <div class="sc-group sc-paco">
      <header class="sc-head" data-reveal>
        <div>
          <div class="sc-brand">
            <span class="sc-mark"><svg viewBox="0 0 120 120"><rect x="10" y="10" width="100" height="58" rx="29" fill="#0288D1" /><rect x="10" y="10" width="30" height="100" rx="15" fill="#01579B" /><rect x="52" y="31" width="8" height="16" rx="4" fill="#fff" /><rect x="66" y="22" width="8" height="34" rx="4" fill="#fff" /><rect x="80" y="27" width="8" height="24" rx="4" fill="#fff" /></svg></span>
            <div><h3>{paco.title}</h3><p>{paco.category}</p></div>
          </div>
          <ul class="sc-tags">{paco.tags.map((t) => <li>{t}</li>)}</ul>
        </div>
        <p class="sc-summary">{paco.summary}</p>
      </header>
      <PacoCards youtubeId={paco.youtubeId} />
    </div>

    <div class="sc-group sc-tb">
      <header class="sc-head" data-reveal>
        <div>
          <div class="sc-brand">
            <span class="sc-mark"><svg viewBox="0 0 120 120" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="12" y="12" width="96" height="96" rx="22" fill="#3d8a66" /><path d="M32 38 H88" stroke="#f1f5f0" stroke-width="7" opacity="0.5" /><path d="M32 58 H88" stroke="#f1f5f0" stroke-width="7" opacity="0.5" /><path d="M30 80 L40 90 L58 71" stroke="#f1f5f0" stroke-width="8" /><path d="M68 81 H88" stroke="#f1f5f0" stroke-width="7" opacity="0.5" /></svg></span>
            <div><h3>{tickbook.title}</h3><p>{tickbook.category}</p></div>
          </div>
          <ul class="sc-tags">{tickbook.tags.map((t) => <li>{t}</li>)}</ul>
        </div>
        <p class="sc-summary">{tickbook.summary}</p>
      </header>
      <TickBookCards youtubeId={tickbook.youtubeId} />
    </div>

    <p class="sc-note">Names, figures and dates in the previews are sample data.</p>
  </div>
</section>

<script>
  import { initShowcase } from "../../scripts/showcase";
  initShowcase();
</script>
