---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found">
  <section class="container-page pt-24 pb-24 flex flex-col items-center text-center">
    <p class="eyebrow mb-4">404</p>
    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight max-w-xl leading-[1.1]">
      This page doesn't exist.
    </h1>
    <p class="text-lg text-[var(--color-ink-muted)] max-w-md mt-6 leading-relaxed">
      The page you're looking for may have moved or never existed.
    </p>
    <a href="/" class="btn btn-primary mt-10">Back to home</a>
  </section>
</Layout>
