---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
---

<Layout title="Contact">
  <section class="container-page pt-20 pb-16">
    <p class="eyebrow mb-4">Contact</p>
    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight max-w-2xl leading-[1.1]">
      Let's build something.
    </h1>
    <p class="text-lg text-[var(--color-ink-muted)] max-w-xl mt-6 leading-relaxed">
      Tell us a bit about the project. We usually reply within 1-2 business days.
    </p>
  </section>

  <section class="section-alt py-16 border-t border-[var(--color-border)]">
    <div class="container-page grid grid-cols-1 md:grid-cols-5 gap-12">
      <form
        class="md:col-span-3 card p-6 md:p-8 flex flex-col gap-5"
        action="https://formspree.io/f/YOUR_FORM_ID"
        method="POST"
      >
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div class="flex flex-col gap-2">
            <label for="name" class="text-sm text-[var(--color-ink-muted)]">Name</label>
            <input
              id="name"
              name="name"
              type="text"
              required
              class="bg-white border border-[var(--color-border)] rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent-soft)]"
            />
          </div>
          <div class="flex flex-col gap-2">
            <label for="email" class="text-sm text-[var(--color-ink-muted)]">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              class="bg-white border border-[var(--color-border)] rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent-soft)]"
            />
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <label for="service" class="text-sm text-[var(--color-ink-muted)]">What do you need help with?</label>
          <select
            id="service"
            name="service"
            class="bg-white border border-[var(--color-border)] rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent-soft)]"
          >
            <option>Web Development</option>
            <option>AI Development</option>
            <option>Data Science & Analysis</option>
            <option>Data & AI Automation</option>
            <option>Not sure yet</option>
          </select>
        </div>

        <div class="flex flex-col gap-2">
          <label for="message" class="text-sm text-[var(--color-ink-muted)]">Project details</label>
          <textarea
            id="message"
            name="message"
            rows="6"
            required
            class="bg-white border border-[var(--color-border)] rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent-soft)] resize-none"
          ></textarea>
        </div>

        <button type="submit" class="btn btn-primary w-fit">Send message</button>
      </form>

      <div class="md:col-span-2">
        <p class="eyebrow mb-3">Direct</p>
        <a href={`mailto:${site.email}`} class="text-lg font-semibold hover:text-[var(--color-accent)] transition-colors">
          {site.email}
        </a>
        <p class="text-sm text-[var(--color-ink-muted)] mt-6 leading-relaxed">
          Prefer email? Reach out directly and include a short description of the project, your
          timeline, and budget range if you have one — it helps us respond with something useful.
        </p>
      </div>
    </div>
  </section>
</Layout>
