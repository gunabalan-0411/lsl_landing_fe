---
import Layout from "../layouts/Layout.astro";
import Showcase from "../components/showcase/Showcase.astro";
import Products from "../components/Products.astro";
import Services from "../components/services/Services.astro";
import Industries from "../components/Industries.astro";
import TechStack from "../components/TechStack.astro";
import ProofTransition from "../components/ProofTransition.astro";
import { site, stack, process } from "../data/site";
import "../styles/fonts.css";
import "../styles/sections.css";
---

<Layout bare>
  <div class="lsl-landing" style="background:var(--cx-bg);color:var(--cx-ink);overflow-x:clip;transition:background .5s ease,color .5s ease">

    <header data-nav class="lsl-nav" style="position:sticky;top:0;z-index:50;background:var(--cx-navbg);backdrop-filter:blur(14px);border-bottom:1px solid var(--cx-navline)">
      <nav style="max-width:76rem;margin-inline:auto;padding:14px 24px;display:flex;align-items:center;gap:26px">
        <a href="#top" aria-label={site.name} style="display:flex;align-items:center">
          <img class="al-logo-on-light" src="/brand/logo-horizontal-light-bg.svg" alt={site.name} style="height:36px;width:auto" />
          <img class="al-logo-on-dark" src="/brand/logo-horizontal-dark-bg.svg" alt={site.name} style="height:36px;width:auto" />
        </a>
        <div style="flex:1"></div>
        <div style="display:flex;align-items:center;gap:22px">
          <a href="#products" data-hide-sm class="lsl-nav-link" style="font-size:13.5px;color:var(--cx-navmuted)">Products</a>
          <a href="#services" data-hide-sm class="lsl-nav-link" style="font-size:13.5px;color:var(--cx-navmuted)">Services</a>
          <a href="#industries" data-hide-sm class="lsl-nav-link" style="font-size:13.5px;color:var(--cx-navmuted)">Industries</a>
          <a href="#work" data-hide-sm class="lsl-nav-link" style="font-size:13.5px;color:var(--cx-navmuted)">Work</a>
          <a href="#process" data-hide-sm class="lsl-nav-link" style="font-size:13.5px;color:var(--cx-navmuted)">Process</a>
          <button id="theme-toggle" title="Toggle theme" class="lsl-theme-toggle" style="display:inline-flex;align-items:center;gap:7px;padding:7px 12px;border-radius:999px;border:1px solid var(--cx-navline);background:var(--cx-navchip);color:var(--cx-navink);font-family:'JetBrains Mono',ui-monospace,monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;transition:background .2s ease">
            <span class="theme-icon" style="font-size:13px">☀</span><span class="theme-label">Light</span>
          </button>
          <a href="#contact" data-magnetic class="lsl-nav-cta" style="display:inline-flex;align-items:center;gap:8px;padding:9px 18px;border-radius:999px;background:var(--cx-navcta);color:var(--cx-navcta-ink);font-size:13.5px;font-weight:600;white-space:nowrap">Start a project</a>
        </div>
      </nav>
    </header>

    <section id="top" data-pause style="position:relative;background:var(--cx-hero);color:var(--cx-hero-ink);overflow:hidden;padding:100px 24px 112px;transition:background .5s ease,color .5s ease">
      <div class="lsl-grain"></div>
      <div style="position:absolute;inset:0;background-image:linear-gradient(var(--cx-hero-line) 1px,transparent 1px),linear-gradient(90deg,var(--cx-hero-line) 1px,transparent 1px);background-size:56px 56px;animation:cx-grid 7s linear infinite;will-change:transform;mask-image:radial-gradient(120% 90% at 50% 0%,#000 25%,transparent 78%)"></div>
      <div style="position:absolute;top:-22%;left:4%;width:52vw;height:52vw;border-radius:50%;background:radial-gradient(circle,var(--cx-blob-a),transparent 66%);animation:cx-drift 18s ease-in-out infinite;will-change:transform"></div>
      <div style="position:absolute;bottom:-30%;right:-6%;width:44vw;height:44vw;border-radius:50%;background:radial-gradient(circle,var(--cx-blob-b),transparent 66%);animation:cx-drift 24s ease-in-out infinite reverse;will-change:transform"></div>
      <div id="hero-spot" style="position:absolute;width:620px;height:620px;left:0;top:0;margin:-310px 0 0 -310px;border-radius:50%;background:radial-gradient(circle,rgba(79,177,143,.2),transparent 60%);pointer-events:none;opacity:0;transition:opacity .45s ease"></div>

      <div style="position:relative;max-width:76rem;margin-inline:auto">
        <div data-stack style="display:grid;grid-template-columns:minmax(0,1.12fr) minmax(0,.88fr);gap:56px;align-items:center">
          <div>
            <span class="hero-in" style="--d:0ms;display:inline-flex;align-items:center;gap:9px;font-family:'JetBrains Mono',ui-monospace,monospace;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--cx-hero-chip-ink);padding:7px 13px;border-radius:999px;border:1px solid var(--cx-hero-chip-line);background:var(--cx-hero-chip-bg);white-space:nowrap">
              <span style="width:6px;height:6px;border-radius:50%;background:#4FB18F;box-shadow:0 0 12px #4FB18F;animation:cx-pulse 2.4s ease-in-out infinite"></span>
              Software &amp; AI studio
            </span>
            <h1 style="margin:22px 0 0;font-size:clamp(42px,5.6vw,78px);line-height:1;letter-spacing:-.035em;font-weight:600;text-wrap:balance">
              <span style="display:block"><span class="hero-word" style="--i:0">AI</span> <span class="hero-word" style="--i:1">made</span> <span class="hero-word" style="--i:2">simple</span></span>
              <span style="display:block;overflow:hidden">
                <span style="display:inline-block;animation:cx-scan 1.1s .45s cubic-bezier(.65,0,.35,1) both;background:var(--cx-hero-grad);-webkit-background-clip:text;background-clip:text;color:transparent">for your business.</span>
                <span style="display:inline-block;width:3px;height:.8em;margin-left:6px;vertical-align:-.04em;background:var(--cx-hero-caret);animation:cx-caret 1s steps(1) 1.6s infinite"></span>
              </span>
            </h1>
            <p class="hero-in" style="--d:420ms;margin:26px 0 0;max-width:34rem;font-size:18.5px;line-height:1.6;color:var(--cx-hero-muted)">
              {site.description}
            </p>
            <div class="hero-in" style="--d:560ms;display:flex;flex-wrap:wrap;gap:12px;margin-top:34px">
              <a href="#contact" data-magnetic class="lsl-hero-cta-primary" style="position:relative;overflow:hidden;display:inline-flex;align-items:center;gap:9px;padding:14px 26px;border-radius:999px;background:var(--cx-accent);color:#fff;font-weight:600;font-size:14.5px;white-space:nowrap;box-shadow:0 14px 34px -14px var(--cx-accent-glow)">
                Start a project
                <span style="position:absolute;top:0;bottom:0;left:0;width:34%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);animation:cx-sheen 3.4s ease-in-out infinite"></span>
              </a>
              <a href="#work" data-magnetic class="lsl-hero-cta-secondary" style="display:inline-flex;align-items:center;gap:9px;padding:14px 26px;border-radius:999px;border:1px solid var(--cx-hero-ghost-line);color:var(--cx-hero-ink);font-weight:600;font-size:14.5px;white-space:nowrap">See the work →</a>
            </div>
            <a class="hero-in lsl-parent" style="--d:700ms" href={site.parent.url} target="_blank" rel="noopener">
              <span class="lsl-parent-dot"></span>A branch of <b>{site.parent.name}</b><span class="lsl-parent-sep">·</span>{site.parent.tagline} ↗
            </a>
          </div>

          <div class="hero-in" style="--d:300ms;position:relative;aspect-ratio:1;display:grid;place-items:center">
            <div style="position:absolute;inset:6%;border-radius:50%;background:radial-gradient(circle,rgba(79,177,143,.34),transparent 66%);animation:cx-glowpulse 5s ease-in-out infinite;will-change:transform,opacity"></div>
            <thinking-orb state="composing" style="position:relative;width:84%;aspect-ratio:1"></thinking-orb>
          </div>
        </div>
      </div>
    </section>

    <div data-pause style="background:var(--cx-hero);border-top:1px solid var(--cx-hero-line2);border-bottom:1px solid var(--cx-hero-line2);padding:15px 0;overflow:hidden;transition:background .5s ease">
      <div style="display:flex;width:max-content;animation:cx-marquee 30s linear infinite;will-change:transform">
        {[0, 1].map(() => (
          <div style="display:flex;gap:44px;padding-right:44px;font-family:'JetBrains Mono',ui-monospace,monospace;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--cx-marquee-ink);white-space:nowrap">
            {stack.map((item) => (
              <>
                <span>{item}</span><span style="color:var(--cx-hero-caret)">◆</span>
              </>
            ))}
          </div>
        ))}
      </div>
    </div>

    <Products />

    <Services />

    <Industries />

    <TechStack />

    <ProofTransition />

    <Showcase />

    <section id="process" class="cv" style="background:var(--cx-bg);padding:100px 24px;transition:background .5s ease;contain-intrinsic-size:auto 520px">
      <div style="max-width:76rem;margin-inline:auto">
        <div data-reveal>
          <span style="font-family:'JetBrains Mono',ui-monospace,monospace;font-size:12px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--cx-accent-ink)">How it goes</span>
          <h2 data-split style="margin:12px 0 44px;font-size:clamp(29px,3.6vw,46px);line-height:1.05;letter-spacing:-.03em;font-weight:600">No black boxes</h2>
        </div>
        <div data-stack style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px">
          {process.map((p) => (
            <div data-reveal class="lsl-process-item" style="position:relative;padding:26px 0 0;border-top:1px solid var(--cx-border);transition:border-color .3s ease">
              <span style="position:absolute;top:-5px;left:0;width:9px;height:9px;border-radius:50%;background:var(--cx-accent);box-shadow:0 0 0 4px var(--cx-accent-soft)"></span>
              <span style="font-family:'JetBrains Mono',ui-monospace,monospace;font-size:12px;letter-spacing:.12em;color:var(--cx-faint)">{p.step}</span>
              <h3 style="margin:12px 0 0;font-size:20px;letter-spacing:-.02em;font-weight:600">{p.title}</h3>
              <p style="margin:9px 0 0;font-size:14.5px;line-height:1.6;color:var(--cx-muted)">{p.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="cv" data-pause style="background:var(--cx-bg);padding:0 24px 100px;transition:background .5s ease;contain-intrinsic-size:auto 600px">
      <div data-reveal style="max-width:76rem;margin-inline:auto;position:relative;overflow:hidden;border-radius:28px;background:var(--cx-cta-bg);color:var(--cx-cta-ink);border:1px solid var(--cx-cta-border);padding:72px 44px;transition:background .5s ease,color .5s ease">
        <div style="position:absolute;inset:0;background-image:linear-gradient(var(--cx-cta-line) 1px,transparent 1px),linear-gradient(90deg,var(--cx-cta-line) 1px,transparent 1px);background-size:44px 44px;animation:cx-grid 9s linear infinite;will-change:transform;mask-image:radial-gradient(90% 90% at 50% 0%,#000,transparent 75%)"></div>
        <div style="position:absolute;bottom:-60%;left:30%;width:40%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,var(--cx-blob-a),transparent 66%);animation:cx-drift 16s ease-in-out infinite;will-change:transform"></div>
        <div style="position:relative;display:flex;flex-direction:column;align-items:center;text-align:center;gap:20px">
          <h2 data-split style="margin:0;font-size:clamp(30px,4.2vw,56px);line-height:1.02;letter-spacing:-.035em;font-weight:600;max-width:32rem;text-wrap:balance">Have something that needs building?</h2>
          <p style="margin:0;max-width:30rem;font-size:17px;line-height:1.6;color:var(--cx-cta-muted)">Tell us the problem and the constraints. We will come back with scope, architecture, and a timeline.</p>
          <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:6px">
            <a href={`mailto:${site.email}`} data-magnetic class="lsl-contact-primary" style="position:relative;overflow:hidden;display:inline-flex;align-items:center;gap:9px;padding:15px 28px;border-radius:999px;background:var(--cx-cta-btn);color:var(--cx-cta-btn-ink);font-weight:600;font-size:15px;white-space:nowrap">{site.email}</a>
            <a href="#services" class="lsl-contact-secondary" style="display:inline-flex;align-items:center;gap:9px;padding:15px 28px;border-radius:999px;border:1px solid var(--cx-cta-ghost);color:var(--cx-cta-ink);font-weight:600;font-size:15px;white-space:nowrap">Browse services</a>
          </div>
          <p style="margin:6px 0 0;font-size:14px;line-height:1.7;color:var(--cx-cta-muted)">
            <a href={`tel:${site.phone.replace(/\s/g, "")}`} style="color:var(--cx-cta-ink)">{site.phone}</a><br />
            {site.location}
          </p>
        </div>
      </div>
    </section>

    <footer class="cv" style="background:var(--cx-surface);border-top:1px solid var(--cx-border);padding:34px 24px 0;overflow:hidden;transition:background .5s ease;contain-intrinsic-size:auto 420px">
      <div style="max-width:76rem;margin-inline:auto;display:flex;flex-wrap:wrap;align-items:center;gap:16px;justify-content:space-between">
        <div style="display:flex;align-items:center;gap:10px">
          <img class="al-logo-on-light" src="/brand/logo-horizontal-light-bg.svg" alt={site.name} style="height:30px;width:auto" />
          <img class="al-logo-on-dark" src="/brand/logo-horizontal-dark-bg.svg" alt={site.name} style="height:30px;width:auto" />
          <span style="font-size:14px;color:var(--cx-muted)">— {site.tagline}</span>
        </div>
        <div style="display:flex;gap:20px;font-size:13.5px;color:var(--cx-muted)">
          <a href={`mailto:${site.email}`} style="color:var(--cx-accent-ink)">{site.email}</a>
          <span>© {new Date().getFullYear()} {site.name} · A branch of <a href={site.parent.url} target="_blank" rel="noopener" style="color:var(--cx-ink);font-weight:600">{site.parent.name}</a></span>
        </div>
      </div>
      <div aria-hidden="true" style="max-width:76rem;margin:28px auto 0;overflow:hidden;container-type:inline-size">
        <div data-wordmark class="lsl-wordmark">{site.name}</div>
      </div>
    </footer>

  </div>

  <script>
    import { initSiteMotion } from "../scripts/site-motion";
    import { initScenes } from "../scripts/scenes";
    import { initProof } from "../scripts/proof";

    initSiteMotion();
    initScenes();
    initProof();
    const root = document.querySelector<HTMLElement>(".lsl-landing");

    if (root) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e, i) => {
            if (e.isIntersecting) {
              (e.target as HTMLElement).style.animationDelay = Math.min(i * 70, 280) + "ms";
              e.target.classList.add("cx-in");
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
      );
      root.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));

      const hero = root.querySelector<HTMLElement>("#top");
      const spot = root.querySelector<HTMLElement>("#hero-spot");
      if (hero && spot) {
        hero.addEventListener("mousemove", (ev) => {
          const r = hero.getBoundingClientRect();
          spot.style.opacity = "1";
          spot.style.transform = `translate(${ev.clientX - r.left}px, ${ev.clientY - r.top}px)`;
        });
        hero.addEventListener("mouseleave", () => {
          spot.style.opacity = "0";
        });
      }

    }

    const toggle = document.getElementById("theme-toggle");
    if (toggle) {
      const icon = toggle.querySelector<HTMLElement>(".theme-icon")!;
      const label = toggle.querySelector<HTMLElement>(".theme-label")!;
      const sync = () => {
        const dark = document.documentElement.getAttribute("data-theme") === "dark";
        icon.textContent = dark ? "☾" : "☀";
        label.textContent = dark ? "Dark" : "Light";
      };
      sync();
      toggle.addEventListener("click", () => {
        const next = document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", next);
        localStorage.setItem("lsl-theme", next);
        sync();
      });
    }
  </script>

  <style is:global>
    :root {
      --cx-bg: #ffffff;
      --cx-surface: #f4f6f8;
      --cx-card: #ffffff;
      --cx-border: #e2e7ec;
      --cx-border-hover: #bfdcd2;
      --cx-ink: #121D31;
      --cx-muted: #566178;
      --cx-faint: #8d97aa;
      --cx-hero: #f1f6f4;
      --cx-hero-ink: #121D31;
      --cx-hero-muted: #566178;
      --cx-hero-line: rgba(18, 29, 49, 0.06);
      --cx-hero-line2: rgba(18, 29, 49, 0.08);
      --cx-hero-grad: linear-gradient(94deg, #121D31 10%, #23816f 55%, #c99c57 95%);
      --cx-hero-caret: #c99c57;
      --cx-hero-chip-ink: #1d7167;
      --cx-hero-chip-bg: rgba(35, 129, 111, 0.1);
      --cx-hero-chip-line: rgba(35, 129, 111, 0.28);
      --cx-hero-ghost-line: rgba(18, 29, 49, 0.2);
      --cx-hero-ghost-hover: rgba(18, 29, 49, 0.05);
      --cx-marquee-ink: rgba(18, 29, 49, 0.45);
      --cx-cta-bg: linear-gradient(140deg, #e8f3ee 0%, #f6f3eb 100%);
      --cx-cta-border: rgba(18, 29, 49, 0.06);
      --cx-cta-ink: #121D31;
      --cx-cta-muted: #566178;
      --cx-cta-line: rgba(18, 29, 49, 0.05);
      --cx-cta-btn: #121D31;
      --cx-cta-btn-ink: #ffffff;
      --cx-cta-btn-hover: #23816f;
      --cx-cta-ghost: rgba(18, 29, 49, 0.2);
      --cx-cta-ghost-hover: rgba(18, 29, 49, 0.05);
      --cx-shadow: rgba(18, 29, 49, 0.28);
      --cx-accent-soft: #e6f4ef;
      --cx-navbg: rgba(255, 255, 255, 0.82);
      --cx-navline: rgba(18, 29, 49, 0.08);
      --cx-navink: #121D31;
      --cx-navmuted: #566178;
      --cx-navchip: rgba(18, 29, 49, 0.04);
      --cx-navchip-hover: rgba(18, 29, 49, 0.09);
      --cx-navcta: #121D31;
      --cx-navcta-ink: #ffffff;
      --cx-navcta-hover: #23816f;
      --cx-accent: #23816f;
      --cx-accent-ink: #1d7167;
      --cx-cyan: #c99c57;
      --cx-accent-glow: rgba(79, 177, 143, 0.8);
      --cx-blob-a: rgba(79, 177, 143, 0.45);
      --cx-blob-b: rgba(221, 180, 106, 0.32);
    }

    [data-theme="dark"] {
      --cx-bg: #0d1626;
      --cx-surface: #111b2e;
      --cx-card: #15213a;
      --cx-border: rgba(255, 255, 255, 0.12);
      --cx-border-hover: rgba(117, 194, 145, 0.45);
      --cx-ink: #f1f5fa;
      --cx-muted: rgba(225, 233, 245, 0.72);
      --cx-faint: rgba(225, 233, 245, 0.5);
      --cx-hero: #0a121f;
      --cx-hero-ink: #ffffff;
      --cx-hero-muted: rgba(255, 255, 255, 0.68);
      --cx-hero-line: rgba(255, 255, 255, 0.055);
      --cx-hero-line2: rgba(255, 255, 255, 0.08);
      --cx-hero-grad: linear-gradient(94deg, #ffffff 12%, #75c291 52%, #ddb46a 92%);
      --cx-hero-caret: #ddb46a;
      --cx-hero-chip-ink: #75c291;
      --cx-hero-chip-bg: rgba(79, 177, 143, 0.14);
      --cx-hero-chip-line: rgba(117, 194, 145, 0.3);
      --cx-hero-ghost-line: rgba(255, 255, 255, 0.22);
      --cx-hero-ghost-hover: rgba(255, 255, 255, 0.08);
      --cx-marquee-ink: rgba(255, 255, 255, 0.45);
      --cx-cta-bg: #121d31;
      --cx-cta-border: rgba(255, 255, 255, 0.06);
      --cx-cta-ink: #ffffff;
      --cx-cta-muted: rgba(255, 255, 255, 0.68);
      --cx-cta-line: rgba(255, 255, 255, 0.05);
      --cx-cta-btn: #ffffff;
      --cx-cta-btn-ink: #121D31;
      --cx-cta-btn-hover: #e6f4ef;
      --cx-cta-ghost: rgba(255, 255, 255, 0.24);
      --cx-cta-ghost-hover: rgba(255, 255, 255, 0.08);
      --cx-navline: rgba(255, 255, 255, 0.1);
      --cx-navink: #ffffff;
      --cx-navchip: rgba(255, 255, 255, 0.07);
      --cx-navchip-hover: rgba(255, 255, 255, 0.16);
      --cx-navcta: #ffffff;
      --cx-navcta-ink: #121D31;
      --cx-navcta-hover: #e6f4ef;
      --cx-shadow: rgba(0, 0, 0, 0.6);
      --cx-accent-soft: rgba(79, 177, 143, 0.18);
      --cx-navbg: rgba(10, 18, 31, 0.82);
      --cx-navmuted: rgba(255, 255, 255, 0.6);
      --cx-accent-ink: #75c291;
      --cx-cyan: #ddb46a;
      --cx-accent-glow: rgba(79, 177, 143, 0.7);
      --cx-blob-a: rgba(79, 177, 143, 0.36);
      --cx-blob-b: rgba(221, 180, 106, 0.26);
    }

    html.lenis {
      scroll-behavior: auto;
    }
    .lsl-nav {
      transition:
        transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
        background 0.5s ease;
    }
    .lsl-nav.is-hidden {
      transform: translateY(-100%);
    }
    [data-magnetic] {
      transition-property: transform, background, border-color, box-shadow, translate;
      transition-duration: 0.25s, 0.25s, 0.25s, 0.25s, 0.5s;
      transition-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .sw-word {
      display: inline-block;
    }
    [data-split] .sw-word {
      opacity: 0;
      filter: blur(12px);
      transform: translateY(0.35em);
      transition:
        opacity 0.9s ease,
        filter 0.9s ease,
        transform 1s cubic-bezier(0.2, 0.8, 0.2, 1);
      transition-delay: calc(var(--i) * 55ms);
    }
    [data-split].is-in .sw-word {
      opacity: 1;
      filter: blur(0);
      transform: none;
    }
    .hero-in {
      animation: cx-rise 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) var(--d, 0ms) both;
    }
    .hero-word {
      display: inline-block;
