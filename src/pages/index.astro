---
import Layout from "../layouts/Layout.astro";
import { site, stack, services, projects, process, languages } from "../data/site";

const ggFin = projects.find((p) => p.slug === "gg-fin")!;
const paco = projects.find((p) => p.slug === "paco")!;
---

<Layout bare>
  <script is:inline src="/thinking-orb.js" defer></script>

  <div class="lsl-landing" style="background:var(--cx-bg);color:var(--cx-ink);overflow-x:hidden;transition:background .5s ease,color .5s ease">

    <header style="position:sticky;top:0;z-index:50;background:var(--cx-navbg);backdrop-filter:blur(14px);border-bottom:1px solid var(--cx-navline)">
      <nav style="max-width:76rem;margin-inline:auto;padding:14px 24px;display:flex;align-items:center;gap:26px">
        <a href="#top" style="display:flex;align-items:center;gap:10px;color:var(--cx-navink)">
          <span style="display:grid;place-items:center;width:34px;height:30px;clip-path:polygon(28% 0%,100% 0%,72% 100%,0% 100%);background:linear-gradient(120deg,var(--cx-accent),var(--cx-cyan));filter:drop-shadow(0 6px 16px var(--cx-accent-glow))">
            <svg width="18" viewBox="0 0 32 32" fill="none"><g stroke="#fff" stroke-width="1.6" stroke-linecap="round" opacity=".7"><path d="M4 11h5"></path><path d="M2.5 16h4.5"></path><path d="M25 21h4.5"></path><path d="M23 26h5"></path></g><path d="M19.6 3.6 10.2 17.2h5.4L13.2 28.4 23.2 14.2h-5.6z" fill="#fff"></path></svg>
          </span>
          <span style="font-weight:600;font-size:16.5px;letter-spacing:-.01em;white-space:nowrap">{site.name}</span>
        </a>
        <div style="flex:1"></div>
        <div style="display:flex;align-items:center;gap:22px">
          <a href="#services" data-hide-sm class="lsl-nav-link" style="font-size:13.5px;color:var(--cx-navmuted)">Services</a>
          <a href="#work" data-hide-sm class="lsl-nav-link" style="font-size:13.5px;color:var(--cx-navmuted)">Work</a>
          <a href="#process" data-hide-sm class="lsl-nav-link" style="font-size:13.5px;color:var(--cx-navmuted)">Process</a>
          <button id="theme-toggle" title="Toggle theme" class="lsl-theme-toggle" style="display:inline-flex;align-items:center;gap:7px;padding:7px 12px;border-radius:999px;border:1px solid var(--cx-navline);background:var(--cx-navchip);color:var(--cx-navink);font-family:'JetBrains Mono',ui-monospace,monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;transition:background .2s ease">
            <span class="theme-icon" style="font-size:13px">☀</span><span class="theme-label">Light</span>
          </button>
          <a href="#contact" class="lsl-nav-cta" style="display:inline-flex;align-items:center;gap:8px;padding:9px 18px;border-radius:999px;background:var(--cx-navcta);color:var(--cx-navcta-ink);font-size:13.5px;font-weight:600;white-space:nowrap">Start a project</a>
        </div>
      </nav>
    </header>

    <section id="top" style="position:relative;background:var(--cx-hero);color:#fff;overflow:hidden;padding:100px 24px 112px;transition:background .5s ease">
      <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.055) 1px,transparent 1px);background-size:56px 56px;animation:cx-grid 7s linear infinite;mask-image:radial-gradient(120% 90% at 50% 0%,#000 25%,transparent 78%)"></div>
      <div style="position:absolute;top:-22%;left:4%;width:52vw;height:52vw;border-radius:50%;background:radial-gradient(circle,var(--cx-blob-a),transparent 62%);filter:blur(30px);animation:cx-drift 18s ease-in-out infinite"></div>
      <div style="position:absolute;bottom:-30%;right:-6%;width:44vw;height:44vw;border-radius:50%;background:radial-gradient(circle,var(--cx-blob-b),transparent 62%);filter:blur(30px);animation:cx-drift 24s ease-in-out infinite reverse"></div>
      <div id="hero-spot" style="position:absolute;width:620px;height:620px;left:0;top:0;margin:-310px 0 0 -310px;border-radius:50%;background:radial-gradient(circle,rgba(120,126,255,.2),transparent 60%);pointer-events:none;opacity:0;transition:opacity .45s ease"></div>

      <div style="position:relative;max-width:76rem;margin-inline:auto">
        <div data-stack style="display:grid;grid-template-columns:minmax(0,1.12fr) minmax(0,.88fr);gap:56px;align-items:center">
          <div>
            <span data-reveal style="display:inline-flex;align-items:center;gap:9px;font-family:'JetBrains Mono',ui-monospace,monospace;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:#a6a9ff;padding:7px 13px;border-radius:999px;border:1px solid rgba(166,169,255,.28);background:rgba(61,67,245,.14);white-space:nowrap">
              <span style="width:6px;height:6px;border-radius:50%;background:#4c52ff;box-shadow:0 0 12px #4c52ff;animation:cx-pulse 2.4s ease-in-out infinite"></span>
              Software &amp; AI studio
            </span>
            <h1 style="margin:22px 0 0;font-size:clamp(42px,5.6vw,78px);line-height:1;letter-spacing:-.035em;font-weight:600;text-wrap:balance">
              <span data-reveal style="display:block">Software &amp; AI,</span>
              <span style="display:block;overflow:hidden">
                <span style="display:inline-block;animation:cx-scan 1.1s .45s cubic-bezier(.65,0,.35,1) both;background:linear-gradient(94deg,#fff 12%,#a6a9ff 52%,#4fd8e0 92%);-webkit-background-clip:text;background-clip:text;color:transparent">engineered.</span>
                <span style="display:inline-block;width:3px;height:.8em;margin-left:6px;vertical-align:-.04em;background:#4fd8e0;animation:cx-caret 1s steps(1) 1.6s infinite"></span>
              </span>
            </h1>
            <p data-reveal style="margin:26px 0 0;max-width:34rem;font-size:18.5px;line-height:1.6;color:rgba(255,255,255,.68)">
              {site.description}
            </p>
            <div data-reveal style="display:flex;flex-wrap:wrap;gap:12px;margin-top:34px">
              <a href="#contact" class="lsl-hero-cta-primary" style="position:relative;overflow:hidden;display:inline-flex;align-items:center;gap:9px;padding:14px 26px;border-radius:999px;background:var(--cx-accent);color:#fff;font-weight:600;font-size:14.5px;white-space:nowrap;box-shadow:0 14px 34px -14px var(--cx-accent-glow)">
                Start a project
                <span style="position:absolute;top:0;bottom:0;left:0;width:34%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);animation:cx-sheen 3.4s ease-in-out infinite"></span>
              </a>
              <a href="#work" class="lsl-hero-cta-secondary" style="display:inline-flex;align-items:center;gap:9px;padding:14px 26px;border-radius:999px;border:1px solid rgba(255,255,255,.22);color:#fff;font-weight:600;font-size:14.5px;white-space:nowrap">See the work →</a>
            </div>
          </div>

          <div data-reveal style="position:relative;aspect-ratio:1;display:grid;place-items:center">
            <div style="position:absolute;inset:6%;border-radius:50%;background:radial-gradient(circle,rgba(61,67,245,.38),transparent 62%);filter:blur(34px);animation:cx-glowpulse 5s ease-in-out infinite"></div>
            <thinking-orb state="composing" theme="dark" style="position:relative;width:84%;aspect-ratio:1"></thinking-orb>
          </div>
        </div>
      </div>
    </section>

    <div style="background:var(--cx-hero);border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.08);padding:15px 0;overflow:hidden">
      <div style="display:flex;width:max-content;animation:cx-marquee 30s linear infinite">
        {[0, 1].map(() => (
          <div style="display:flex;gap:44px;padding-right:44px;font-family:'JetBrains Mono',ui-monospace,monospace;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.45);white-space:nowrap">
            {stack.map((item) => (
              <>
                <span>{item}</span><span style="color:#4fd8e0">◆</span>
              </>
            ))}
          </div>
        ))}
      </div>
    </div>

    <section id="services" style="background:var(--cx-bg);padding:100px 24px;transition:background .5s ease">
      <div style="max-width:76rem;margin-inline:auto">
        <div data-reveal style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:44px">
          <div>
            <span style="font-family:'JetBrains Mono',ui-monospace,monospace;font-size:12px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--cx-accent-ink)">What we do</span>
            <h2 style="margin:12px 0 0;font-size:clamp(29px,3.6vw,46px);line-height:1.05;letter-spacing:-.03em;font-weight:600">Five practices, one team</h2>
          </div>
          <p style="margin:0;max-width:26rem;font-size:15.5px;line-height:1.6;color:var(--cx-muted)">Engagements run end to end — discovery through post-launch support. Take one practice or combine them.</p>
        </div>

        <div data-stack style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px">
          {services.map((s, i) => (
            <div data-reveal data-tilt class="lsl-service-card" style="position:relative;overflow:hidden;background:var(--cx-card);border:1px solid var(--cx-border);border-radius:20px;padding:30px;box-shadow:0 1px 2px rgba(15,18,40,.04);transition:box-shadow .3s ease,border-color .3s ease,transform .2s ease">
              <div style="display:flex;align-items:center;justify-content:space-between;gap:14px">
                <span style="font-family:'JetBrains Mono',ui-monospace,monospace;font-size:12px;letter-spacing:.1em;color:var(--cx-faint)">{String(i + 1).padStart(2, "0")}</span>
                <span style="width:34px;height:34px;border-radius:11px;display:grid;place-items:center;background:var(--cx-accent-soft);color:var(--cx-accent-ink);font-size:15px">↗</span>
              </div>
              <h3 style="margin:18px 0 0;font-size:23px;letter-spacing:-.02em;font-weight:600">{s.title}</h3>
              <p style="margin:10px 0 0;font-size:15px;line-height:1.6;color:var(--cx-muted)">{s.summary}</p>
              <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:20px">
                {s.points.map((p) => (
                  <span style="display:inline-flex;align-items:center;padding:.4rem .9rem;border-radius:999px;background:var(--cx-surface);border:1px solid var(--cx-border);font-size:12.5px;color:var(--cx-muted)">{p}</span>
                ))}
              </div>
              <span class="lsl-card-underline" style="position:absolute;left:0;right:0;bottom:0;height:2px;background:linear-gradient(90deg,var(--cx-accent),var(--cx-cyan));transform:scaleX(0);transform-origin:left;transition:transform .45s cubic-bezier(.2,.8,.2,1)"></span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="work" style="background:var(--cx-surface);padding:100px 24px;border-top:1px solid var(--cx-border);transition:background .5s ease">
      <div style="max-width:76rem;margin-inline:auto">
        <div data-reveal>
          <span style="font-family:'JetBrains Mono',ui-monospace,monospace;font-size:12px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--cx-accent-ink)">Selected work</span>
          <h2 style="margin:12px 0 38px;font-size:clamp(28px,3.4vw,44px);line-height:1.08;letter-spacing:-.03em;font-weight:600;text-wrap:balance">Two platforms, built end to end</h2>
        </div>

        <div data-reveal data-stack style="display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:22px;align-items:stretch">
          <div style="background:#0e1120;color:#fff;border-radius:24px;padding:36px;display:flex;flex-direction:column;gap:22px;position:relative;overflow:hidden">
            <div style="position:absolute;top:-30%;right:-20%;width:60%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,var(--cx-blob-a),transparent 65%);filter:blur(22px);animation:cx-drift 20s ease-in-out infinite"></div>
            <div style="position:relative;display:flex;flex-wrap:wrap;gap:10px">
              <span style="padding:.35rem .8rem;border-radius:999px;background:rgba(255,255,255,.12);font-size:12px;color:#fff">{ggFin.category}</span>
              <span style="display:inline-flex;align-items:center;gap:7px;padding:.35rem .8rem;border-radius:999px;background:rgba(79,216,224,.16);font-size:12px;color:#8ff0f6"><span style="width:6px;height:6px;border-radius:50%;background:#4fd8e0;animation:cx-pulse 2.6s ease-in-out infinite"></span>{ggFin.status}</span>
            </div>
            <p style="position:relative;margin:0;font-size:17px;line-height:1.65;color:rgba(255,255,255,.8);text-wrap:pretty">
              {ggFin.summary}
            </p>
            <div style="position:relative;display:flex;flex-wrap:wrap;gap:8px;margin-top:auto">
              {ggFin.tags.map((t) => (
                <span style="padding:.4rem .85rem;border-radius:999px;border:1px solid rgba(255,255,255,.18);font-family:'JetBrains Mono',ui-monospace,monospace;font-size:11.5px;color:rgba(255,255,255,.75)">{t}</span>
              ))}
            </div>
          </div>

          <div style="background:var(--cx-card);border:1px solid var(--cx-border);border-radius:24px;padding:36px;display:flex;flex-direction:column">
            <span style="font-size:52px;line-height:.6;color:var(--cx-accent-ink)">&ldquo;</span>
            <p style="margin:18px 0 0;font-size:17.5px;line-height:1.7;color:var(--cx-ink);text-wrap:pretty">
              {ggFin.testimonial!.quote}
            </p>
            <div style="display:flex;align-items:center;gap:12px;margin-top:auto;padding-top:26px">
              <span style="width:40px;height:40px;border-radius:50%;background:linear-gradient(140deg,var(--cx-accent),var(--cx-cyan));display:grid;place-items:center;color:#fff;font-weight:600;font-size:14px">{ggFin.testimonial!.name[0]}</span>
              <div>
                <div style="font-size:14.5px;font-weight:600">{ggFin.testimonial!.name}</div>
                <div style="font-size:13px;color:var(--cx-muted)">{ggFin.testimonial!.role}</div>
              </div>
            </div>
          </div>
        </div>

        <div data-reveal data-stack style="display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:22px;align-items:stretch;margin-top:22px">
          <div style="background:var(--cx-card);border:1px solid var(--cx-border);border-radius:24px;padding:36px;display:flex;flex-direction:column;gap:20px">
            <div style="display:flex;flex-wrap:wrap;gap:10px">
              <span style="padding:.35rem .8rem;border-radius:999px;background:var(--cx-accent-soft);font-size:12px;color:var(--cx-accent-ink)">{paco.category}</span>
              <span style="display:inline-flex;align-items:center;gap:7px;padding:.35rem .8rem;border-radius:999px;background:var(--cx-surface);border:1px solid var(--cx-border);font-size:12px;color:var(--cx-muted)"><span style="width:6px;height:6px;border-radius:50%;background:#0a8f97;animation:cx-pulse 2.6s ease-in-out infinite"></span>{paco.status}</span>
            </div>
            <h3 style="margin:0;font-size:26px;line-height:1.15;letter-spacing:-.025em;font-weight:600">{paco.title}</h3>
            <a href={paco.link} target="_blank" rel="noreferrer" class="lsl-paco-link" style="display:inline-flex;align-items:center;gap:7px;width:fit-content;font-family:'JetBrains Mono',ui-monospace,monospace;font-size:12px;letter-spacing:.06em;color:var(--cx-accent-ink)">{paco.linkLabel} ↗</a>
            {paco.summaryParagraphs!.map((para) => (
              <p style="margin:0;font-size:16.5px;line-height:1.65;color:var(--cx-muted);text-wrap:pretty">{para}</p>
            ))}
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:auto">
              {paco.tags.map((t) => (
                <span style="padding:.4rem .85rem;border-radius:999px;border:1px solid var(--cx-border);background:var(--cx-surface);font-family:'JetBrains Mono',ui-monospace,monospace;font-size:11.5px;color:var(--cx-muted)">{t}</span>
              ))}
            </div>
          </div>

          <div style="align-self:start;background:#0e1120;color:#fff;border-radius:24px;padding:36px;display:flex;flex-direction:column;gap:22px;position:relative;overflow:hidden">
            <div style="position:absolute;bottom:-34%;left:-16%;width:60%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,var(--cx-blob-b),transparent 65%);filter:blur(22px);animation:cx-drift 22s ease-in-out infinite"></div>
            <span style="position:relative;font-family:'JetBrains Mono',ui-monospace,monospace;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:#a6a9ff">Asked in the app</span>
            <div style="position:relative;display:flex;flex-direction:column;gap:14px">
              {paco.asks!.map((q) => (
                <div style="display:flex;gap:12px;align-items:flex-start;padding:16px 18px;border-radius:16px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1)">
                  <span style="flex:none;margin-top:2px;font-family:'JetBrains Mono',ui-monospace,monospace;font-size:11px;color:#4fd8e0">{q.mode}</span>
                  <span style="font-size:15.5px;line-height:1.5;color:rgba(255,255,255,.92)">{q.text}</span>
                </div>
              ))}
            </div>
            <p style="position:relative;margin:0;font-size:14px;line-height:1.6;color:rgba(255,255,255,.6)">Answers are scoped to the signed-in role — a parent sees their own child, a teacher their own class.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="process" style="background:var(--cx-bg);padding:100px 24px;transition:background .5s ease">
      <div style="max-width:76rem;margin-inline:auto">
        <div data-reveal>
          <span style="font-family:'JetBrains Mono',ui-monospace,monospace;font-size:12px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--cx-accent-ink)">How it goes</span>
          <h2 style="margin:12px 0 44px;font-size:clamp(29px,3.6vw,46px);line-height:1.05;letter-spacing:-.03em;font-weight:600">No black boxes</h2>
        </div>
        <div data-stack style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px">
          {process.map((p) => (
            <div data-reveal class="lsl-process-item" style="position:relative;padding:26px 0 0;border-top:1px solid var(--cx-border);transition:border-color .3s ease">
              <span style="position:absolute;top:-5px;left:0;width:9px;height:9px;border-radius:50%;background:var(--cx-accent);box-shadow:0 0 0 4px var(--cx-accent-soft)"></span>
              <span style="font-family:'JetBrains Mono',ui-monospace,monospace;font-size:12px;letter-spacing:.12em;color:var(--cx-faint)">{p.step}</span>
              <h3 style="margin:12px 0 0;font-size:20px;letter-spacing:-.02em;font-weight:600">{p.title}</h3>
              <p style="margin:9px 0 0;font-size:14.5px;line-height:1.6;color:var(--cx-muted)">{p.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section style="background:var(--cx-surface);border-top:1px solid var(--cx-border);border-bottom:1px solid var(--cx-border);padding:64px 24px;margin-bottom:100px;transition:background .5s ease">
      <div data-reveal data-stack style="max-width:76rem;margin-inline:auto;display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:36px;align-items:center">
        <div>
          <span style="font-family:'JetBrains Mono',ui-monospace,monospace;font-size:12px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--cx-accent-ink)">Multilingual by default</span>
          <h2 style="margin:12px 0 0;font-size:clamp(24px,2.6vw,34px);line-height:1.15;letter-spacing:-.025em;font-weight:600;text-wrap:balance">Your users ask in their own language</h2>
          <p style="margin:12px 0 0;font-size:15.5px;line-height:1.6;color:var(--cx-muted)">Speech in, speech out, and handwriting recognition for records that were never typed in the first place.</p>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:12px">
          {languages.map((l) => (
            <div class="lsl-lang-card" style="flex:1 1 9rem;padding:20px;border-radius:16px;background:var(--cx-card);border:1px solid var(--cx-border);transition:border-color .3s ease,transform .2s ease">
              <div style="font-size:24px;letter-spacing:-.01em;font-weight:600">{l.native}</div>
              <div style="margin-top:6px;font-family:'JetBrains Mono',ui-monospace,monospace;font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--cx-faint)">{l.name}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" style="background:var(--cx-bg);padding:0 24px 100px;transition:background .5s ease">
      <div data-reveal style="max-width:76rem;margin-inline:auto;position:relative;overflow:hidden;border-radius:28px;background:#0e1120;color:#fff;padding:72px 44px">
        <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);background-size:44px 44px;animation:cx-grid 9s linear infinite;mask-image:radial-gradient(90% 90% at 50% 0%,#000,transparent 75%)"></div>
        <div style="position:absolute;bottom:-60%;left:30%;width:40%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,var(--cx-blob-a),transparent 62%);filter:blur(24px);animation:cx-drift 16s ease-in-out infinite"></div>
        <div style="position:relative;display:flex;flex-direction:column;align-items:center;text-align:center;gap:20px">
          <h2 style="margin:0;font-size:clamp(30px,4.2vw,56px);line-height:1.02;letter-spacing:-.035em;font-weight:600;max-width:32rem;text-wrap:balance">Have something that needs building?</h2>
          <p style="margin:0;max-width:30rem;font-size:17px;line-height:1.6;color:rgba(255,255,255,.7)">Tell us the problem and the constraints. We will come back with scope, architecture, and a timeline.</p>
          <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:6px">
            <a href={`mailto:${site.email}`} class="lsl-contact-primary" style="position:relative;overflow:hidden;display:inline-flex;align-items:center;gap:9px;padding:15px 28px;border-radius:999px;background:#fff;color:#0e1120;font-weight:600;font-size:15px;white-space:nowrap">{site.email}</a>
            <a href="#services" class="lsl-contact-secondary" style="display:inline-flex;align-items:center;gap:9px;padding:15px 28px;border-radius:999px;border:1px solid rgba(255,255,255,.24);color:#fff;font-weight:600;font-size:15px;white-space:nowrap">Browse services</a>
          </div>
        </div>
      </div>
    </section>

    <footer style="background:var(--cx-surface);border-top:1px solid var(--cx-border);padding:34px 24px;transition:background .5s ease">
      <div style="max-width:76rem;margin-inline:auto;display:flex;flex-wrap:wrap;align-items:center;gap:16px;justify-content:space-between">
        <div style="display:flex;align-items:center;gap:10px">
          <span style="display:grid;place-items:center;width:30px;height:26px;clip-path:polygon(28% 0%,100% 0%,72% 100%,0% 100%);background:linear-gradient(120deg,var(--cx-accent),var(--cx-cyan))">
            <svg width="15" viewBox="0 0 32 32" fill="none"><g stroke="#fff" stroke-width="1.8" stroke-linecap="round" opacity=".7"><path d="M4 11h5"></path><path d="M2.5 16h4.5"></path><path d="M25 21h4.5"></path><path d="M23 26h5"></path></g><path d="M19.6 3.6 10.2 17.2h5.4L13.2 28.4 23.2 14.2h-5.6z" fill="#fff"></path></svg>
          </span>
          <span style="font-size:14px;font-weight:600">{site.name}</span>
          <span style="font-size:14px;color:var(--cx-muted)">— {site.tagline}</span>
        </div>
        <div style="display:flex;gap:20px;font-size:13.5px;color:var(--cx-muted)">
          <a href={`mailto:${site.email}`} style="color:var(--cx-accent-ink)">{site.email}</a>
          <span>© {new Date().getFullYear()} {site.name}</span>
        </div>
      </div>
    </footer>

  </div>

  <script>
    const root = document.querySelector<HTMLElement>(".lsl-landing");

    if (root) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e, i) => {
            if (e.isIntersecting) {
              (e.target as HTMLElement).style.animationDelay = Math.min(i * 70, 280) + "ms";
              e.target.classList.add("cx-in");
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
      );
      root.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));

      const hero = root.querySelector<HTMLElement>("#top");
      const spot = root.querySelector<HTMLElement>("#hero-spot");
      if (hero && spot) {
        hero.addEventListener("mousemove", (ev) => {
          const r = hero.getBoundingClientRect();
          spot.style.opacity = "1";
          spot.style.transform = `translate(${ev.clientX - r.left}px, ${ev.clientY - r.top}px)`;
        });
        hero.addEventListener("mouseleave", () => {
          spot.style.opacity = "0";
        });
      }

      root.querySelectorAll<HTMLElement>("[data-tilt]").forEach((card) => {
        card.addEventListener("mousemove", (ev) => {
          const r = card.getBoundingClientRect();
          const dx = (ev.clientX - r.left) / r.width - 0.5;
          const dy = (ev.clientY - r.top) / r.height - 0.5;
          card.style.transform = `perspective(900px) rotateY(${dx * 5}deg) rotateX(${-dy * 5}deg) translateY(-3px)`;
        });
        card.addEventListener("mouseleave", () => {
          card.style.transform = "";
        });
      });
    }

    const toggle = document.getElementById("theme-toggle");
    if (toggle) {
      const icon = toggle.querySelector<HTMLElement>(".theme-icon")!;
      const label = toggle.querySelector<HTMLElement>(".theme-label")!;
      const sync = () => {
        const dark = document.documentElement.getAttribute("data-theme") === "dark";
        icon.textContent = dark ? "☾" : "☀";
        label.textContent = dark ? "Dark" : "Light";
      };
      sync();
      toggle.addEventListener("click", () => {
        const next = document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", next);
        localStorage.setItem("lsl-theme", next);
        sync();
      });
    }
  </script>

