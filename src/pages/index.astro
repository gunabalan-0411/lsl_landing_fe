  </style>

  <style>
    .lsl-landing {
      font-family: "General Sans", ui-sans-serif, system-ui, sans-serif;
    }
    .lsl-landing a {
      text-decoration: none;
    }
    .lsl-landing ::selection {
      background: var(--cx-accent);
      color: #fff;
    }

    @keyframes cx-rise {
      from {
        opacity: 0;
        transform: translateY(26px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    @keyframes cx-scan {
      0% {
        clip-path: inset(0 100% 0 0);
      }
      100% {
        clip-path: inset(0 0 0 0);
      }
    }
    @keyframes cx-caret {
      0%,
      100% {
        opacity: 1;
      }
      50% {
        opacity: 0;
      }
    }
    @keyframes cx-drift {
      0% {
        transform: translate3d(0, 0, 0) scale(1);
      }
      50% {
        transform: translate3d(6%, -4%, 0) scale(1.1);
      }
      100% {
        transform: translate3d(0, 0, 0) scale(1);
      }
    }
    @keyframes cx-marquee {
      from {
        transform: translateX(0);
      }
      to {
        transform: translateX(-50%);
      }
    }
    @keyframes cx-grid {
      from {
        transform: translateY(0);
      }
      to {
        transform: translateY(56px);
      }
    }
    @keyframes cx-pulse {
      0%,
      100% {
        opacity: 0.35;
        transform: scale(1);
      }
      50% {
        opacity: 1;
        transform: scale(1.5);
      }
    }
    @keyframes cx-sheen {
      0% {
        transform: translateX(-140%);
      }
      100% {
        transform: translateX(320%);
      }
    }
    @keyframes cx-glowpulse {
      0%,
      100% {
        opacity: 0.45;
        transform: scale(0.9);
      }
      50% {
        opacity: 0.9;
        transform: scale(1.12);
      }
    }

    .lsl-landing [data-reveal] {
      opacity: 0;
    }
    .lsl-landing [data-reveal].cx-in {
      animation: cx-rise 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    }
    @media (prefers-reduced-motion: reduce) {
      .lsl-landing [data-reveal],
      .lsl-landing [data-reveal].cx-in {
        opacity: 1;
        animation: none;
      }
    }
    @media (max-width: 1000px) {
      .lsl-landing [data-hide-sm] {
        display: none !important;
      }
    }
    @media (max-width: 900px) {
      .lsl-landing [data-stack] {
        grid-template-columns: minmax(0, 1fr) !important;
      }
      .lsl-landing [data-hide-sm] {
        display: none !important;
      }
    }

    .lsl-nav-link:hover {
      color: var(--cx-navink);
    }
    .lsl-theme-toggle:hover {
      background: var(--cx-navchip-hover);
    }
    .lsl-nav-cta:hover {
